{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-job-search/submission-manifest.schema.json",
  "title": "Recorded external application submission",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "application_id": { "type": "string", "minLength": 1 },
    "submission_id": { "type": "string", "minLength": 1 },
    "package_id": { "type": ["string", "null"] },
    "evidence_level": { "enum": ["exact_files", "source_only", "status_only"] },
    "submitted_at": { "type": "string" },
    "recorded_at": { "type": "string" },
    "channel": { "enum": ["company_portal", "email", "recruiting_agent", "linkedin", "other"] },
    "external_reference": { "type": ["string", "null"] },
    "note": { "type": ["string", "null"] },
    "selected_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "files": { "type": "array", "items": { "$ref": "material-package-manifest.schema.json#/$defs/file" } }
  },
  "required": ["schema_version", "application_id", "submission_id", "package_id", "evidence_level", "submitted_at", "recorded_at", "channel", "external_reference", "note", "selected_paths", "files"]
}
