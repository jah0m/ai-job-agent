{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-job-search/draft-manifest.schema.json",
  "title": "Mutable application draft manifest",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template_revision": { "type": "string", "minLength": 1 },
        "complete_documents": { "type": "boolean" },
        "missing": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "string" } },
        "placeholders": { "type": "array", "items": { "type": "string" } },
        "format_valid": { "type": "boolean" },
        "ready": { "type": "boolean" }
      },
      "required": ["template_revision", "complete_documents", "missing", "errors", "placeholders", "format_valid", "ready"]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "role": { "enum": ["content_source", "editable_source", "deliverable", "supporting"] },
        "purpose": { "enum": ["rirekisho", "shokumu_keirekisho", "employer_form", "portfolio", "other"] },
        "origin": { "enum": ["codex_generated", "user_uploaded", "external_export", "employer_template", "unknown"] },
        "media_type": { "type": "string" },
        "source_path": { "type": ["string", "null"] }
      },
      "required": ["path", "size", "sha256", "role", "purpose", "origin", "media_type", "source_path"]
    }
  },
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "draft" },
    "application_id": { "type": "string", "minLength": 1 },
    "draft_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["empty", "working"] },
    "revision": { "type": "integer", "minimum": 0 },
    "base_package_id": { "type": ["string", "null"] },
    "relative_path": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "validated_at": { "type": "string" },
    "label": { "type": ["string", "null"] },
    "template_revision": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "required": ["schema_version", "kind", "application_id", "draft_id", "status", "revision", "relative_path", "created_at", "updated_at", "template_revision", "files", "validation"]
}
